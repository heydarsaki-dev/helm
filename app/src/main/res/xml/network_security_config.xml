<?xml version="1.0" encoding="utf-8"?>
<!--
  The Hermes gateway normally listens on loopback of the same phone
  (hermes gateway run -> 127.0.0.1:8642). Cleartext stays off everywhere
  except loopback and the private ranges a user might point the app at
  (a LAN gateway, or 10.0.2.2 from an emulator).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="true">local</domain>
    </domain-config>
</network-security-config>
